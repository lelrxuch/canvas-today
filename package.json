{
  "name": "canvas-today",
  "productName": "Canvas Today",
  "version": "1.2.0",
  "description": "Widget de escritorio con tus pendientes de Canvas",
  "main": "src/main/index.js",
  "author": "Cristopher Contreras",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lelrxuch/canvas-today.git"
  },
  "homepage": "https://github.com/lelrxuch/canvas-today#readme",
  "bugs": {
    "url": "https://github.com/lelrxuch/canvas-today/issues"
  },
  "desktopName": "canvas-today.desktop",
  "scripts": {
    "start": "electron .",
    "demo": "CANVAS_TODAY_DEMO=1 electron .",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test",
    "dist": "electron-builder --linux AppImage",
    "dist:win": "electron-builder --win nsis"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "electron": "^44.9.3",
    "electron-builder": "^26.18.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.10"
  },
  "build": {
    "appId": "gt.cris.canvastoday",
    "productName": "Canvas Today",
    "publish": null,
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Education",
      "icon": "assets/icon.png",
      "artifactName": "Canvas-Today-${version}.AppImage",
      "synopsis": "Tus pendientes de Canvas en el escritorio"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.ico",
      "artifactName": "Canvas-Today-Setup-${version}.exe"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "shortcutName": "Canvas Today"
    }
  }
}
